#куда отправлять данные (и учетные данные с правами comps-updater)
apihost=user:password@inventory.domain.local
#куда писать лог
logfile=/var/log/inventory.log
#признак что это виртуальная машина
virtual=1
#где хранить ID своей записи в БД (он передается при отправке, чтобы пережить переименование хоста).
#в золотом образе, с которого клонируются машины, этого файла быть не должно,
#иначе все клоны унаследуют один ID и будут перезаписывать одну запись
comp_id_file=/var/lib/inventory/comp.id